// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Person (ISAPI Format: UserInfo Search)
// Menggabungkan Employee & Guest sesuai ERD (person)
model person {
  employeeNo      String      @id @db.VarChar(32) // ID Utama dari ISAPI
  name            String      @db.VarChar(128)
  userType        UserType    @default(normal)    // normal (karyawan), visitor (tamu)
  gender          Gender      @default(unknown)
  
  // Field ISAPI untuk validasi akses
  validEnable     Boolean     @default(true)
  validBeginTime  DateTime?
  validEndTime    DateTime?
  
  // Field Tambahan untuk ERD Mustering
  last_synced_at  DateTime    @default(now())

  // Relasi ke Log
  access_records  access_record[]
}

// 2. Gate (Sesuai ERD)
model gate {
  id              String      @id @default(uuid())
  device_id       String?     @unique
  name            String      @db.VarChar(128)
  
  // Detail Koneksi ISAPI
  ip_address      String?     @db.VarChar(64)
  username        String?     @db.VarChar(64)
  password        String?     @db.VarChar(128)
  
  status          GateStatus  @default(OFFLINE)
  mode            GateMode    @default(NORMAL)

  access_records  access_record[]
}

// 3. Access Record (ISAPI Format: AcsEvent)
model access_record {
  serialNo           String      @id @db.VarChar(128) // ID Utama ISAPI
  major              Int         // Event Major Code
  minor              Int         // Event Minor Code
  time               DateTime    // Timestamp dari ISAPI
  
  // Relasi sesuai ERD
  person_id          String?     @db.VarChar(32)
  person             person?     @relation(fields: [person_id], references: [employeeNo])
  
  gate_id            String?
  gate               gate?       @relation(fields: [gate_id], references: [id])

  @@index([time])
  @@index([person_id])
}

// 4. Account (Sesuai ERD - Menggantikan UserAuth)
model account {
  id              String      @id @default(uuid())
  name            String      @db.VarChar(128)
  username        String      @unique @db.VarChar(64)
  password        String      @db.VarChar(255)
  role            AccountRole @default(SECURITY)
  createdAt       DateTime    @default(now())
}

// --- Enums (Strictly ISAPI Compatible) ---

enum UserType {
  normal
  visitor
  blackList
  administrators
}

enum Gender {
  male
  female
  unknown
}

enum GateStatus {
  OPEN
  CLOSED
  OFFLINE
}

enum GateMode {
  NORMAL
  EMERGENCY
}

enum AccountRole {
  ADMIN
  SECURITY
}

enum Direction {
  IN
  OUT
}

enum AccessStatus {
  GRANTED
  DENIED
}
